# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local dev databases
*.db
test_sentinelreview.db
*.rdb

# Eval harness output (regenerated by running evaluation/run_eval.py)
evaluation/results*.json

# Environment
.env
.env.local

# Frontend (frontend/.gitignore already covers node_modules/dist,
# but a root-level rule is a safety net for anyone running commands
# from the repo root instead of frontend/)
frontend/node_modules/
frontend/dist/
